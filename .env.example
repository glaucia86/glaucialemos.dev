# Contact and testimonial forms: all five values are required to enable submission (server only).
# Resend (https://resend.com): sending-only API key restricted to the verified domain. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Sender on the verified domain, e.g. Site Glaucia Lemos <contato@mail.glaucialemos.dev>.
# Before the domain is verified: Site <onboarding@resend.dev> (delivers only to the Resend account's own email).
CONTACT_FROM=
# Inbox that receives the messages (kept out of the code).
CONTACT_TO=
TURNSTILE_SECRET_KEY=
# Widget key: read on the server and rendered in the widget (public by design, no NEXT_PUBLIC_ needed).
TURNSTILE_SITE_KEY=
# Additional allowed verification hostnames, comma-separated (optional).
# Also authorize these hosts in the Turnstile dashboard. Actions are checked per form.
TURNSTILE_ALLOWED_HOSTNAMES=
# Required only for the waitlist. At least 32 characters after trimming, server only.
# Generate with: openssl rand -base64 48
WAITLIST_SIGNING_SECRET=
# Optional HTTPS origin for confirmation links; defaults to https://glaucialemos.dev.
# Never derived from request headers. Invalid values fall back to the default.
SITE_URL=
